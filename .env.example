# ============================================================================
# Avenza 2.0 — environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets.
# NEXT_PUBLIC_* values are exposed to the browser — keep secrets out of them.
# ============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Phase 3: PostgreSQL + Prisma) ---
DATABASE_URL="postgresql://avenza:avenza@localhost:5432/avenza?schema=public"

# --- Auth (Phase 3: Auth.js / NextAuth v5) ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# --- Email (Phase 4: provider-abstracted) ---
EMAIL_PROVIDER="resend"          # resend | ses | sendgrid | smtp
EMAIL_API_KEY=""                 # provider API key (Resend/SendGrid)
EMAIL_FROM="Avenza <no-reply@avenza-consulting.com>"
HR_EMAIL="careers@avenza-consulting.com"
BUSINESS_EMAIL="hello@avenza-consulting.com"
# SMTP fallback (only if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- File storage (Phase 4: S3-compatible for resumes) ---
STORAGE_PROVIDER="s3"            # s3 | r2 | local
STORAGE_BUCKET="avenza-resumes"
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""              # set for R2/MinIO; leave blank for AWS S3
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Analytics (configurable provider) ---
NEXT_PUBLIC_ANALYTICS_PROVIDER=""   # plausible | ga4 | posthog | (blank = off)
NEXT_PUBLIC_ANALYTICS_ID=""

# --- Rate limiting (Phase 6: optional Upstash Redis; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error reporting (Phase 6, optional) ---
SENTRY_DSN=""
